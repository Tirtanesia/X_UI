name: Test Bluetooth Patch Only

on:
  workflow_dispatch:

jobs:
  test-bt:
    runs-on: ubuntu-24.04
    steps:
      - name: Free disk space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
          sudo apt-get clean

      - name: Checkout repo (Fast Shallow)
        uses: actions/checkout@v4
        with:
          fetch-depth: 1
          submodules: recursive
          shallow-submodules: true

      - name: Set up build environment
        run: |
          sudo apt-get update
          sudo apt-get install -y attr cpio erofs-utils f2fs-tools git lz4 python3 openjdk-21-jdk xxd zip unzip

      - name: Build dependencies
        run: |
          source buildenv.sh c1s
          make tools

      - name: Download & Extract Only Bluetooth APEX
        run: |
          source buildenv.sh c1s
          # Mengunduh dan mengekstrak firmware sumber (S26+) serta target (c1s)
          ./scripts/download_fw.sh
          ./scripts/extract_fw.sh

      - name: Run Isolated Bluetooth Patch Test
        run: |
          source buildenv.sh c1s
          mkdir -p "$WORK_DIR/system/system/apex"
          SOURCE_PATH="$(cut -d "/" -f 1 -s <<< "$SOURCE_FIRMWARE")_$(cut -d "/" -f 2 -s <<< "$SOURCE_FIRMWARE")"
          cp -a "$FW_DIR/$SOURCE_PATH/system/system/apex/com.android.bt.apex" "$WORK_DIR/system/system/apex/"
          
          echo "=== MULAI TES BLUETOOTH PATCH ==="
          MODPATH="$SRC_DIR/unica/patches/bluetooth"
          source "$MODPATH/customize.sh"
          echo "=== SELESAI TES BLUETOOTH PATCH ==="
